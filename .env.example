# Mizan configuration. Copy to .env and fill in. Never commit the real file.

# ---- required -------------------------------------------------------------
# https://console.groq.com/keys
GROQ_API_KEY=

# ---- provider -------------------------------------------------------------
# groq (hosted) or ollama (local, needs a GPU to be usable)
CONTRACT_AI_PROVIDER=groq

# Must exist on your Groq account. Free-tier limits differ per model.
#   qwen/qwen3.8-27b     1000 req/day,  8000 TPM   (default)
#   openai/gpt-oss-20b   1000 req/day,  8000 TPM
#   groq/compound         250 req/day, 12000 TPM
# CONTRACT_AI_ANALYSIS_MODEL=qwen/qwen3.8-27b

# Pace the client to the model's real limits.
# CONTRACT_AI_TPM=8000
# CONTRACT_AI_MAX_CONCURRENCY=2
# CONTRACT_AI_MAX_OUTPUT=900

# ---- corpus and index -----------------------------------------------------
# Where the corpus lives. Relative paths resolve against the repo root.
# MIZAN_DATA_DIR=data

# Narrow retrieval by contract type. Off by default - the shipped corpus tags
# articles with a vocabulary the classifier does not emit, and filtering costs
# 16 points of Recall@3. See DEPLOYMENT.md section 6.
# MIZAN_TYPE_FILTER=0

# Empty = embedded Qdrant (single process). Set both for a Qdrant server, and
# load the collection with scripts/load_qdrant_server.py first.
# QDRANT_URL=
# QDRANT_API_KEY=

# ---- models ---------------------------------------------------------------
# Where the embedding model is cached. /opt/models inside the Docker image.
# HF_HOME=

# ---- OCR (optional, scanned documents only) -------------------------------
# Windows path to the Tesseract binary; on Linux it is found on PATH.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
